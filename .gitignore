# OS files
.DS_Store
._*
Thumbs.db
Desktop.ini

# Editor and IDE files
.idea/
.vscode/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local environment and secrets
.env
.env.local
.env.*.local
/server/*.local.yaml

# Logs and runtime state
*.log
*.pid
logs/
/server/log/
/server/latest_log

# Gin Vue Admin / Go runtime outputs
/server/gva
/server/gva.exe
/server/server
/server/server.exe
/server/__debug_bin*
/server/.cache/
/server/uploads/

# Go build and test outputs
*.test
*.out
coverage.out
/coverage/

# Frontend dependencies and build outputs
/web/node_modules/
/web/dist/
/web/.vite/
/web/.cache/
/web/coverage/
/web/.pnpm-debug.log
/web/pnpm-lock.yaml

# Project local runtime/cache
/tmp/
rm_file/

# Binary and archive outputs
*.exe
*.dll
*.so
*.dylib
*.tgz
*.tar
*.tar.gz
*.zip
*.7z
*.rar

# Prebuilt Windows static deployment artifacts.
# This directory intentionally stores generated dist files and gva-server.exe
# so low-memory Windows targets can git pull and run without building.
!/deploy/windows-static/
!/deploy/windows-static/**
/deploy/windows-static/server/config.local.yaml
/deploy/windows-static/server/log/
/deploy/windows-static/server/latest_log
/deploy/windows-static/server/uploads/*
!/deploy/windows-static/server/uploads/
!/deploy/windows-static/server/uploads/.gitkeep
!/deploy/windows-static/server/uploads/file/
/deploy/windows-static/server/uploads/file/*
!/deploy/windows-static/server/uploads/file/.gitkeep
/deploy/windows-static/tmp/static-runtime/logs/
/deploy/windows-static/tmp/static-runtime/pids/
/deploy/windows-static/tmp/static-runtime/go-cache/
/deploy/windows-static/tmp/static-runtime/go-mod/
/deploy/windows-static/tmp/windows-lowmem-deploy/

# Local database files
*.db
*.sqlite
*.sqlite3
