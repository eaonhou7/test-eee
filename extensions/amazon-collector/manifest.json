{
  "manifest_version": 3,
  "name": "Amazon / 1688 采集助手",
  "description": "从 Amazon 详情页和 1688 图搜/详情页采集商品数据并写入系统采集池。",
  "version": "0.1.9",
  "key": "",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://www.amazon.ca/*",
    "https://www.amazon.com.mx/*",
    "https://s.1688.com/*",
    "https://detail.1688.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Amazon / 1688 采集助手",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://www.amazon.ca/*",
        "https://www.amazon.com.mx/*"
      ],
      "js": [
        "content-amazon.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://s.1688.com/*",
        "https://detail.1688.com/*",
        "https://cart.1688.com/*",
        "https://trade.1688.com/*"
      ],
      "js": [
        "content-1688.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "extractors/amazon-detail.js",
        "extractors/alibaba-1688-detail.js",
        "content-1688-page-bridge.js"
      ],
      "matches": [
        "https://www.amazon.com/*",
        "https://www.amazon.ca/*",
        "https://www.amazon.com.mx/*",
        "https://s.1688.com/*",
        "https://detail.1688.com/*"
      ]
    }
  ]
}
